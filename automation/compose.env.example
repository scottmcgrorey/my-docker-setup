# 🦎 KOMODO COMPOSE - VARIABLES 🦎 #
COMPOSE_KOMODO_IMAGE_TAG=latest
COMPOSE_KOMODO_BACKUPS_PATH=/etc/dockerfiles/komodo/backups
KOMODO_DB_USERNAME=admin
KOMODO_DB_PASSWORD=admin_password_change_me_NEVER
KOMODO_PASSKEY=
PERIPHERY_PASSKEY=
KOMODO_SSL_ENABLED=false
PERIPHERY_SSL_ENABLED=false

# --- AUTH FIXES --- #
KOMODO_LOCAL_AUTH=true
#KOMODO_INIT_ADMIN_USERNAME=admin
#KOMODO_INIT_ADMIN_PASSWORD=changeme
KOMODO_DISABLE_USER_REGISTRATION=true
# ------------------ #

KOMODO_FIRST_SERVER=http://periphery:8120
KOMODO_FIRST_SERVER_NAME=LocalHost
